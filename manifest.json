{
  "manifest_version": 3,
  "name": "Bridge",
  "version": "0.1.0",
  "description": "Local-first memory bridge across AI chat platforms.",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/claude.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["src/content/chatgpt.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Bridge"
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Open Bridge dashboard"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/workers/*", "models/*"],
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ]
}
